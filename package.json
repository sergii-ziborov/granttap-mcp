{
  "name": "granttap-mcp",
  "version": "0.7.0",
  "description": "Personal live control center runtime for local coding agents on iPhone and Apple Watch.",
  "type": "module",
  "bin": {
    "granttap": "bin/granttap-mcp.mjs",
    "granttap-mcp": "bin/granttap-mcp.mjs"
  },
  "files": [
    "apps",
    "bin",
    "cursor-plugin",
    "docs",
    "packages",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/granttap-mcp.mjs",
    "internal:serve": "node bin/granttap-mcp.mjs internal serve",
    "cursor:repair": "node bin/granttap-mcp.mjs cursor repair",
    "setup": "node bin/granttap-mcp.mjs setup",
    "status": "node bin/granttap-mcp.mjs status",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "c8 --all --extension .ts --exclude 'tests/**' --exclude 'scripts/**' --exclude 'packages/core/relay-client-types.ts' --exclude 'apps/bridge/src/capabilities/types.ts' --exclude 'apps/bridge/src/reply/types.ts' --check-coverage --lines 95 --statements 95 --functions 95 --branches 85 node --import tsx --test tests/*.test.ts",
    "inventory": "node scripts/quality/source-inventory.mjs",
    "package:allowlist": "node scripts/quality/package-allowlist.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run package:allowlist && npm run test:coverage && npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "c8": "^10.1.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/granttap-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sergii-ziborov/granttap-mcp/issues"
  },
  "homepage": "https://granttap.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "grok-build",
    "iphone",
    "apple-watch",
    "e2ee",
    "approvals"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
